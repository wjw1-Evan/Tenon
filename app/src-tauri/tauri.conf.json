{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tenon",
  "version": "0.1.0",
  "identifier": "dev.tenonide.tenon",
  "build": {
    "beforeDevCommand": "pnpm --filter tenon-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter tenon-ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tenon",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tenon-daemon"
    ]
  }
}
