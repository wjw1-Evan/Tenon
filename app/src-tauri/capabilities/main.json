{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主窗口能力（§6.2 桌面壳）：集成式标题栏拖拽区域 + 壳 IPC 命令（本地上下文 = devUrl 开发态）",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "shell:allow-open",
    "notification:default",
    "allow-get-handshake",
    "allow-get-update-notes",
    "allow-dismiss-update-notes",
    "allow-get-update-ready",
    "allow-install-update"
  ]
}
