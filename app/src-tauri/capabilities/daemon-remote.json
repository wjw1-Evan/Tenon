{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-daemon-remote",
  "description": "主窗口 daemon 托管 UI（§6.2 生产拓扑）的 remote 上下文：与本地能力集一致——拖拽/缩放、系统目录对话框、shell 外链与五壳 IPC 命令（仅回环地址，v1.156）",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "shell:allow-open",
    "allow-get-handshake",
    "allow-get-update-notes",
    "allow-dismiss-update-notes",
    "allow-get-update-ready",
    "allow-install-update"
  ]
}
